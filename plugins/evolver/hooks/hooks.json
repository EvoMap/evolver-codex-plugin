{
  "description": "Evolver: prompt-relevant strategy recall, turn-end reuse reports, and session-end distillation, with no tools in the model's context",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.mjs\"",
            "command_windows": "node \"%PLUGIN_ROOT%\\hooks\\session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\"",
            "command_windows": "node \"%PLUGIN_ROOT%\\hooks\\user-prompt-submit.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/pre-tool-use.mjs\"",
            "command_windows": "node \"%PLUGIN_ROOT%\\hooks\\pre-tool-use.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/post-tool-use.mjs\"",
            "command_windows": "node \"%PLUGIN_ROOT%\\hooks\\post-tool-use.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/stop.mjs\"",
            "command_windows": "node \"%PLUGIN_ROOT%\\hooks\\stop.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/interrupt.mjs\"",
            "command_windows": "node \"%PLUGIN_ROOT%\\hooks\\interrupt.mjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-end.mjs\"",
            "command_windows": "node \"%PLUGIN_ROOT%\\hooks\\session-end.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
